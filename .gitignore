# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# application logs
/logs/

# covers .env, .env.bak and .env.key
.env
.env.bak
.env.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/generated/prisma

# kubernetes and docker
k8s/

# claude setting
.claude/

# deployment guide
DEPLOYMENT.md

# sql exclude
*.sql

# ...except migrations. `prisma migrate deploy` applies only what is committed, so an ignored
# migration.sql is a schema change that never reaches the server.
!prisma/migrations/**/*.sql