// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPERADMIN
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  password              String?
  name                  String
  role                  Role                      @default(USER)
  avatar                String?
  avatarFileId          String?
  passwordChangedAt     DateTime?
  passwordExpiresAt     DateTime?
  emailVerified         DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  settings              UserSetting[]
  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  budgets               Budget[]
  goals                 Goal[]
  tags                  Tag[]
  notifications         Notification[]

  @@map("users")
}

model UserSetting {
  id                    String                    @id @default(cuid())
  userId                String
  key                   String   
  value                 String   
  icon                  String   
  type                  String                    @default("boolean") 
  category              String                    @default("general") 
  description           String?  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, key])
  @@index([userId])
  @@index([userId, category])
  @@map("user_settings")
}

model AppSettingAudit {
  id                    String                    @id @default(cuid())
  key                   String
  action                String
  previousValue         String?
  newValue              String?
  actorId               String?
  actorEmail            String?
  createdAt             DateTime                  @default(now())

  @@index([key])
  @@index([createdAt])
  @@map("app_setting_audits")
}

model AppSetting {
  id                    String                    @id @default(cuid())
  key                   String                    @unique
  value                 String                        
  type                  String                    @default("string")   
  category              String                    @default("general")  
  label                 String
  description           String?
  sortOrder             Int                       @default(0)
  isPublic              Boolean                   @default(true)       
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([category])
  @@index([isPublic])
  @@map("app_settings")
}

model AuditLog {
  id                    String                    @id @default(cuid())
  entityType            String
  entityId              String
  action                String
  previousValue         Json?
  newValue              Json?
  actorId               String?
  actorEmail            String?
  createdAt             DateTime                  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id                    String                    @id @default(cuid())
  userId                String
  type                  String
  title                 String
  message               String
  link                  String?
  isRead                Boolean                   @default(false)
  createdAt             DateTime                  @default(now())

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model VerificationToken {
  identifier            String
  token                 String
  expires               DateTime
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([identifier, token], name: "identifier_token")
  @@map("verification_token")
}

enum AccountType {
  CASH
  BANK
  EWALLET
  CREDIT_CARD
  INVESTMENT
}

model Account {
  id                    String                    @id @default(cuid())
  userId                String
  name                  String
  type                  AccountType
  balance               Decimal                   @default(0) @db.Decimal(15, 2)
  currency              String                    @default("IDR")
  creditLimit           Decimal?                  @db.Decimal(15, 2)
  color                 String?
  icon                  String?
  isDefault             Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]             @relation("SourceAccount")
  incomingTransfers     Transaction[]             @relation("DestinationAccount")
  valueHistories        AccountValueHistory[]

  @@index([userId])
  @@map("accounts")
}

model AccountValueHistory {
  id                    String                    @id @default(cuid())
  accountId             String
  previousBalance       Decimal                   @db.Decimal(15, 2)
  newBalance            Decimal                   @db.Decimal(15, 2)
  changeAmount          Decimal                   @db.Decimal(15, 2)
  changePercent         Decimal                   @db.Decimal(9, 4)
  note                  String?
  recordedAt            DateTime                  @default(now())
  createdAt             DateTime                  @default(now())

  account               Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, recordedAt])
  @@map("account_value_histories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Transaction {
  id                    String                    @id @default(cuid())
  userId                String
  accountId             String
  toAccountId           String?
  categoryId            String?
  amount                Decimal                   @db.Decimal(15, 2)
  type                  TransactionType
  description           String?
  date                  DateTime
  attachment            String?
  exchangeRate          Decimal?                  @db.Decimal(18, 6)
  convertedAmount       Decimal?                  @db.Decimal(15, 2)
  isRecurring           Boolean                   @default(false)
  recurrenceInterval    RecurrenceInterval?
  recurrenceKey         String?
  nextOccurrence        DateTime?
  recurrenceEndDate     DateTime?
  recurrenceDismissedAt DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account                   @relation("SourceAccount", fields: [accountId], references: [id])
  toAccount             Account?                  @relation("DestinationAccount", fields: [toAccountId], references: [id])
  category              Category?                 @relation(fields: [categoryId], references: [id])
  tags                  Tag[]

  @@index([userId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([date])
  @@index([userId, isRecurring])
  @@index([userId, recurrenceKey])
  @@index([userId, nextOccurrence])
  @@map("transactions")
}

model Tag {
  id                    String                    @id @default(cuid())
  userId                String
  name                  String
  color                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id                    String                    @id @default(cuid())
  userId                String?
  name                  String
  type                  CategoryType
  icon                  String?
  color                 String?
  isDefault             Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]

  @@index([userId])
  @@map("categories")
}

model Budget {
  id                    String                    @id @default(cuid())
  userId                String
  categoryId            String
  amount                Decimal                   @db.Decimal(15, 2)
  spent                 Decimal                   @default(0) @db.Decimal(15, 2)
  month                 Int
  year                  Int
  autoRenew             Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category                  @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId])
  @@map("budgets")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Goal {
  id                    String                    @id @default(cuid())
  userId                String
  name                  String
  targetAmount          Decimal                   @db.Decimal(15, 2)
  currentAmount         Decimal                   @default(0) @db.Decimal(15, 2)
  currency              String                    @default("IDR")
  deadline              DateTime?
  status                GoalStatus                @default(ACTIVE)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}