# ─────────────────────────────────────────────────────────────────────────────
# Finarthax — environment template
#
#   cp .env.example .env      then fill in the blanks below
#
# Only the values marked REQUIRED are needed to boot. Everything else switches on
# an optional feature, and the app degrades cleanly when it is missing.
#
# Values can be sealed afterwards with `npm run encrypt`. Leave this template in
# plain text — it holds placeholders, not secrets, and it is the one env file
# that gets committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Points at your PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finarthax"

# Only needed for docker-compose and Kubernetes: the Postgres container is
# created from these, and entrypoint.sh waits on them before starting the app.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="finarthax"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# REQUIRED. NEXTAUTH_URL is the public base URL, also used in password-reset
# links and in the buttons inside notification emails.
# Generate the secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Session lifetime in seconds.
SESSION_EXPIRATION="900"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Optional. Leave empty to offer email + password sign-in only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── ImageKit (avatar uploads) ────────────────────────────────────────────────
# Optional. IMAGEKIT_UPLOAD_EXPIRE_SEC is capped at 3600 by the API.
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_UPLOAD_EXPIRE_SEC="3600"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Optional. Without RESEND_API_KEY nothing is sent: password resets fail loudly
# and every notification email reports "not-configured" instead of throwing.
RESEND_API_KEY=""
RESEND_EMAIL_FROM="Finarthax <onboarding@resend.dev>"

# ── Scheduled digest (POST /api/notifications/digest) ────────────────────────
# Optional. The bearer token a scheduler must present. While this is empty the
# endpoint stays disabled, so weekly summaries and recurring reminders are never
# delivered. Generate one with:  openssl rand -base64 32
CRON_SECRET=""

# ── Currency ─────────────────────────────────────────────────────────────────
# The currency amounts are stored in. Everything else is converted for display.
BASE_CURRENCY="IDR"
BASE_CURRENCY_SYMBOL="Rp"
EXCHANGE_RATE_URL="https://api.exchangerate-api.com/v4/latest"

# ── Health probe ─────────────────────────────────────────────────────────────
# How long /api/health waits for the database, and how long a result is cached.
DATABASE_TIMEOUT_MS="5000"
HEALTH_CACHE_TTL_MS="10000"

# ─────────────────────────────────────────────────────────────────────────────
# Deliberately not listed here: ENV_ENCRYPTION_KEY
#
# The key that unlocks an encrypted .env must not live inside the file it
# unlocks. Run `npm run env:key` to write .env.key locally, or set
# ENV_ENCRYPTION_KEY in the environment on a server.
# ─────────────────────────────────────────────────────────────────────────────